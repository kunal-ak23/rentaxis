# Copy to .env.local and fill in. .env.local is gitignored.
#
# Prod base URL (Next.js app — proxy lives here).
PROD_BASE_URL=https://rentaxis.uaenorth.cloudapp.azure.com

# SUPER_ADMIN credentials. Required for tests that provision a fresh test
# tenant (01-provision and everything downstream). If unset, only 00-smoke-auth
# will run.
PROD_SUPERADMIN_EMAIL=
PROD_SUPERADMIN_PASSWORD=

# Optional: skip tenant cleanup at end of run (useful when debugging a failed run).
SKIP_CLEANUP=0
