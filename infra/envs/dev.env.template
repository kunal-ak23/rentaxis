# =============================================================================
# RentAxis Environment Configuration — DEV
# Copy this to dev.env and fill in the values before deploying.
# =============================================================================

# --- Azure ---
# Subscription the resources live in. Leave blank to use the az CLI's current
# default (`az account show`). Set it when you have more than one subscription,
# or after migrating to a new one — the infra scripts run `az account set` with
# this value so every provision/deploy/email command targets the right place.
AZURE_SUBSCRIPTION=
AZURE_RESOURCE_GROUP=rentaxis-dev-rg
AZURE_LOCATION=centralindia
AZURE_VM_NAME=rentaxis-dev-vm
AZURE_VM_SIZE=Standard_B2s
AZURE_DISK_SIZE_GB=128
AZURE_STORAGE_ACCOUNT=rentaxisdevfiles
AZURE_DNS_LABEL=rentaxis-dev
AZURE_ADMIN_USER=rentaxis

# --- Domain / TLS ---
# Set to your domain once DNS is pointed. Caddy auto-provisions HTTPS.
# Leave as the Azure DNS label for dev (HTTP only via :80).
DOMAIN=rentaxis-dev.centralindia.cloudapp.azure.com

# --- PostgreSQL ---
POSTGRES_USER=rentaxis
POSTGRES_PASSWORD=CHANGE_ME_DEV_PASSWORD
POSTGRES_DB=rentaxis

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rentaxis
SPRING_DATASOURCE_USERNAME=rentaxis
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DEV_PASSWORD
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_AES_KEY_HERE__
BACKEND_URL=http://backend:8080

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=https://rentaxis-dev.centralindia.cloudapp.azure.com
NEXTAUTH_URL=https://rentaxis-dev.centralindia.cloudapp.azure.com
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_SECRET_FOR_JWT

# --- Azure Blob Storage (for tenant file uploads) ---
AZURE_STORAGE_CONNECTION_STRING=FILL_AFTER_PROVISION
AZURE_STORAGE_CONTAINER_PREFIX=tenant-
