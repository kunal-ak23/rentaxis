# =============================================================================
# RentAxis Environment Configuration — PROD
# Copy this to prod.env and fill in the values before deploying.
# =============================================================================

# --- Azure ---
# Subscription the resources live in. Leave blank to use the az CLI's current
# default (`az account show`). Set it when you have more than one subscription,
# or after migrating to a new one — the infra scripts run `az account set` with
# this value so every provision/deploy/email command targets the right place.
AZURE_SUBSCRIPTION=
AZURE_RESOURCE_GROUP=rentaxis-prod-rg
AZURE_LOCATION=centralindia
AZURE_VM_NAME=rentaxis-prod-vm
AZURE_VM_SIZE=Standard_B2s
AZURE_DISK_SIZE_GB=128
AZURE_STORAGE_ACCOUNT=rentaxisprodfiles
AZURE_DNS_LABEL=rentaxis
AZURE_ADMIN_USER=rentaxis

# --- Domain / TLS ---
DOMAIN=app.rentaxis.com

# --- PostgreSQL ---
POSTGRES_USER=rentaxis
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PROD_PASSWORD
POSTGRES_DB=rentaxis

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rentaxis
SPRING_DATASOURCE_USERNAME=rentaxis
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PROD_PASSWORD
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_AES_KEY_HERE__
BACKEND_URL=http://backend:8080

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=https://app.rentaxis.com
NEXTAUTH_URL=https://app.rentaxis.com
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_SECRET_FOR_JWT

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=FILL_AFTER_PROVISION
AZURE_STORAGE_CONTAINER_PREFIX=tenant-

# --- Gate pass: Firebase Phone Authentication ---
# Required by the backend in prod. Base64 the complete Firebase Admin service
# account JSON onto one line; never commit the JSON or decoded value.
# Full setup: docs/runbooks/firebase-phone-auth-setup.md
FIREBASE_PROJECT_ID=FILL_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=FILL_BASE64_SERVICE_ACCOUNT_JSON
