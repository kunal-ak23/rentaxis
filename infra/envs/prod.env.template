# =============================================================================
# RentAxis Environment Configuration — PROD
# Copy this to prod.env and fill in the values before deploying.
# =============================================================================

# --- Azure ---
AZURE_RESOURCE_GROUP=rentaxis-prod-rg
AZURE_LOCATION=centralindia
AZURE_VM_NAME=rentaxis-prod-vm
AZURE_VM_SIZE=Standard_B2s
AZURE_DISK_SIZE_GB=128
AZURE_STORAGE_ACCOUNT=rentaxisprodfiles
AZURE_DNS_LABEL=rentaxis
AZURE_ADMIN_USER=rentaxis

# --- Domain / TLS ---
DOMAIN=app.rentaxis.com

# --- PostgreSQL ---
POSTGRES_USER=rentaxis
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PROD_PASSWORD
POSTGRES_DB=rentaxis

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rentaxis
SPRING_DATASOURCE_USERNAME=rentaxis
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PROD_PASSWORD
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_AES_KEY_HERE__
BACKEND_URL=http://backend:8080

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=https://app.rentaxis.com
NEXTAUTH_URL=https://app.rentaxis.com
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_SECRET_FOR_JWT

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=FILL_AFTER_PROVISION
AZURE_STORAGE_CONTAINER_PREFIX=tenant-

# --- Gate pass: security-guard login OTP delivery ---
# Guard login codes go out over WhatsApp via ACS.
# Optional: both deploy.yml and docker-compose.prod.yml already default this to
# `whatsapp`, so prod selects the real sender whether or not this is set. Set it
# to `log` only if you want the dev sender — and note that it is @Profile("!prod")
# and would leave prod with no OtpSender bean, failing the context at startup.
GATEPASS_OTP_CHANNEL=whatsapp
# REQUIRED — set this BEFORE the first deploy.
# Channel registration id (a GUID) of the WhatsApp Business number connected to
# the ACS resource. Azure portal -> Communication Service -> Advanced Messaging
# -> Channels. Requires a Meta WhatsApp Business Account linked first.
# Because the channel defaults to `whatsapp`, leaving this blank makes the
# backend REFUSE TO START. That is deliberate: the alternative was a prod that
# booted clean, answered 200 to every guard OTP request, and delivered nothing.
# Full setup: docs/runbooks/whatsapp-otp-setup.md
ACS_WHATSAPP_CHANNEL_ID=FILL_AFTER_WHATSAPP_CHANNEL_CONNECTED
# Name of the Meta-APPROVED WhatsApp *authentication* template used to carry the
# code. Must exist and be approved on the channel above, with a body parameter
# and a copy-code/URL button. Sends fail until approval lands.
GATEPASS_OTP_TEMPLATE_NAME=gatepass_otp
# Language tag of that template, and it must MATCH the approved one exactly.
# Meta's editor produces `en` for "English" and `en_US` for "English (US)" —
# if you picked the latter, set this to en_US. A mismatch fails at send time
# only; nothing catches it at startup.
GATEPASS_OTP_TEMPLATE_LANGUAGE=en
# NOTE: reuses AZURE_COMMUNICATION_CONNECTION_STRING (see the email section of
# the deploy secrets) — one ACS resource serves both email and WhatsApp.
