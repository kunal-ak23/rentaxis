{$DOMAIN} {
    # Frontend — Next.js
    handle /api/proxy/* {
        # API proxy requests go to Next.js (which proxies to backend)
        reverse_proxy web:3000
    }

    handle /api/auth/* {
        # Auth endpoints (mobile apps + direct API calls)
        reverse_proxy backend:8080
    }

    handle /api/admin/* {
        # Admin endpoints (mobile apps)
        reverse_proxy backend:8080
    }

    handle /api/v1/* {
        # API v1 endpoints (mobile apps + webhooks + external integrations)
        reverse_proxy backend:8080
    }

    handle /api/webhooks/* {
        # Webhook endpoints
        reverse_proxy backend:8080
    }

    handle /actuator/* {
        # Health check endpoints
        reverse_proxy backend:8080
    }

    handle {
        reverse_proxy web:3000
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    # Gzip compression
    encode gzip

    # Access logs
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 5
        }
    }
}
