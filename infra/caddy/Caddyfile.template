{$DOMAIN} {
    # SECURITY: X-Internal-Auth is a server-to-server secret asserted only by the
    # Next.js server (which reaches the backend via BACKEND_URL on the Docker
    # network and never transits Caddy). Any X-Internal-Auth arriving at this
    # edge is forged, so it is stripped on every route that proxies to the
    # backend.
    #
    # X-User-Id / X-User-Role / X-User-Tenant-Id / X-Tenant-Id are deliberately
    # NOT stripped here yet: installed mobile builds still authenticate with
    # these legacy headers. Phase 2: once all mobile apps send Bearer tokens and
    # the backend runs with APP_AUTH_LEGACY_HEADERS=deny, strip X-User-* and
    # X-Tenant-Id on these backend routes too.

    # Backend auth endpoints (mobile apps + Next.js credentials provider)
    handle /api/auth/login {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }
    handle /api/auth/register {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }
    handle /api/auth/apple {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }
    handle /api/auth/me* {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }
    handle /api/auth/set-password {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }
    handle /api/auth/set-password/* {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }
    # Public "forgot password" (PR #408). The mobile apps call it directly; without
    # this block it fell through to NextAuth below and never reached the backend.
    handle /api/auth/forgot-password {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }

    # All other /api/auth/* → Next.js NextAuth handler
    # (csrf, signin, signout, callback/*, providers, session, error, verify-request, _log)
    handle /api/auth/* {
        reverse_proxy web:3000
    }

    # Frontend API proxy requests go to Next.js
    handle /api/proxy/* {
        reverse_proxy web:3000
    }

    # Admin endpoints (mobile apps)
    handle /api/admin/* {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }

    # API v1 endpoints (mobile apps + webhooks + external)
    handle /api/v1/* {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }

    # Webhook endpoints
    handle /api/webhooks/* {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }

    # Listings management + renter marketplace (mobile apps call these
    # directly; without these routes they fall through to Next.js and 404)
    handle /api/listings* {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }
    handle /api/marketplace/* {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }

    # Health check
    handle /actuator/* {
        request_header -X-Internal-Auth
        reverse_proxy backend:8080
    }

    # Everything else — Next.js frontend
    handle {
        reverse_proxy web:3000
    }

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    encode gzip

    # The access log records every request header. Caddy redacts Authorization and
    # Cookie on its own, but not X-Api-Key, which carries a promoter's full partner
    # API secret (mfk_live_...): drop it before the line is written.
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request>headers>X-Api-Key delete
            }
        }
    }
}
