# ============================================================
# RentAxis — Infrastructure Configuration
# ============================================================
# This file is sourced by all provisioning scripts.
# Update these values for your environment.
# ============================================================

# Azure
AZURE_RESOURCE_GROUP=rentaxis-rg
AZURE_LOCATION=uaenorth
AZURE_SUBSCRIPTION=  # leave blank to use default

# Communication Services (Email)
AZURE_COMM_SERVICE_NAME=rentaxis-comm
AZURE_EMAIL_SERVICE_NAME=rentaxis-email

# Storage (Blob)
AZURE_STORAGE_ACCOUNT=rentaxisstorage

# VM / Deployment
AZURE_VM_NAME=rentaxis-vm
AZURE_VM_IP=rentaxis.uaenorth.cloudapp.azure.com
