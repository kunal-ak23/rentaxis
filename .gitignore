# Environment files (keep .template files)
.env
.env.*
.env.backend
.env.web
.env.postgres
!.env.*.template
infra/envs/*.env
!infra/envs/*.env.template

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Claude
.claude/

# Worktrees
.worktrees/

# Generated contracts
data/contracts/
backend/data/
graphify-out/

# Prod E2E artifacts
web/e2e-prod/.auth/
web/e2e-prod/.test-context.json
web/e2e-prod/.env.local
web/e2e-prod/playwright-report/
web/e2e-prod/test-results/
# Keep the template even though web/.gitignore matches .env*
!web/e2e-prod/.env.local.example
scripts/seed_demo_tenant.out.json
scripts/seed_demo_tenant.out.*.bak.json
scripts/seed_tutorial_tenant.out.json
scripts/__pycache__/
# Approved narrated tutorial deliverables belong to the project and must remain
# visible to version control/workspace backup. Keep raw footage and intermediates
# local-only, but do not silently ignore the final MP4/SRT outputs.
tutorials/output/*
!tutorials/output/
!tutorials/output/*.mp4
!tutorials/output/*.srt
tutorials/raw/
tutorials/work/
tutorials/.env.local
!tutorials/.env.local.example
tutorials/audio-generated/*
!tutorials/audio-generated/README.md

# Walkthrough capture output. Raw takes are large binaries and this repo already
# carries ~1GB of committed media (#143); keep recordings out of git history.
web/walkthrough/raw/
web/walkthrough/run-manifest*.json
web/walkthrough/takes/

# Screenshot proof runs — regenerate with proof-shots.spec.ts, don't commit binaries
web/walkthrough/proof/
