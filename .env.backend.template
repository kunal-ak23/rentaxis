# Copy this file to .env.backend and fill in real values for local dev.
# Production values are sourced from GitHub repository secrets via CI.

# ── Database (use 'postgres' as host when running in Docker) ──────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rentaxis
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_PROFILES_ACTIVE=dev

# ── Backend URL for inter-service communication ───────────────────────
BACKEND_URL=http://localhost:8080

# ── Azure Communication Services (Email) ──────────────────────────────
# Get the connection string from: az communication list-key --name <comm-svc> -g <rg>
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_SENDER=

# ── Azure Storage (Blob) for cheque images, listings media, etc. ──────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_PREFIX=tenant-

# ── Azure OpenAI (cheque photo extraction) ────────────────────────────
# Optional. Leave blank in dev to skip OCR; the scan UI gracefully degrades.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHEQUE_DEPLOYMENT=gpt-4o

# ── Encryption key (any 32-byte secret; production uses GH secret) ────
ENCRYPTION_KEY=
